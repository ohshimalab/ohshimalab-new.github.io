---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';

const researchAreas = [
	{
		title: '情報検索',
		description: '大量の情報の中から、人の目的や状況に合う情報を見つけるための検索・推薦技術を研究しています。',
	},
	{
		title: 'データマイニング',
		description: 'ウェブや社会に蓄積されたデータを分析し、そこにある傾向や関係、新しい価値を発見します。',
	},
	{
		title: '情報デザイン',
		description: '人が情報を理解し、探索し、意思決定するまでの体験を、インタフェースと情報提示の両面から設計します。',
	},
];

const relatedFields = ['データベース', '機械学習', '自然言語処理', 'ウェブマイニング', 'ヒューマンコンピュータインタラクション'];
---

<BaseLayout title="教員紹介 | 大島研究室" description="大島研究室の教員、大島裕明准教授のプロフィールと研究分野を紹介します。">
	<section class="profile-hero">
		<div class="container profile-hero__inner">
			<img src={sitePath('media/hiroaki-ohshima.jpg')} width="270" height="270" alt="大島 裕明" />
			<div class="profile-hero__text">
				<p class="eyebrow">Faculty</p>
				<h1>大島 裕明</h1>
				<p class="name-en">Hiroaki Ohshima</p>
				<p class="position">准教授</p>
				<p class="affiliation">兵庫県立大学 大学院情報科学研究科<br />社会情報科学部</p>
				<p class="contact"><a href="mailto:ohshima@ai.u-hyogo.ac.jp">ohshima@ai.u-hyogo.ac.jp</a></p>
			</div>
		</div>
	</section>

	<div class="container profile-page">
		<section class="introduction" aria-labelledby="introduction-heading">
			<p class="section-label">About</p>
			<h2 id="introduction-heading">情報との出会いを、より豊かに。</h2>
			<p>
				社会の中で人が情報を取得し、理解し、意思決定することを支える技術を研究しています。
				情報検索、データマイニング、情報デザインを軸に、情報学のさまざまな知見を組み合わせながら、
				人と情報のよりよい関係を探究しています。
			</p>
		</section>

		<section class="research" aria-labelledby="research-heading">
			<p class="section-label">Research</p>
			<h2 id="research-heading">主な研究分野</h2>
			<div class="research-grid">
				{researchAreas.map((area) => (
					<article>
						<h3>{area.title}</h3>
						<p>{area.description}</p>
					</article>
				))}
			</div>
			<ul class="field-tags" aria-label="関連する研究分野">
				{relatedFields.map((field) => <li>{field}</li>)}
			</ul>
		</section>

		<section class="background" aria-labelledby="background-heading">
			<div>
				<p class="section-label">Background</p>
				<h2 id="background-heading">略歴</h2>
			</div>
			<div class="background__body">
				<p>
					2007年、京都大学大学院情報学研究科博士後期課程修了。博士（情報学）。
					同年から京都大学大学院情報学研究科にて教育・研究に従事し、2017年より兵庫県立大学。
				</p>
				<dl>
					<div>
						<dt>2007</dt>
						<dd>京都大学大学院 情報学研究科 博士後期課程修了</dd>
					</div>
					<div>
						<dt>2007–2017</dt>
						<dd>京都大学大学院 情報学研究科</dd>
					</div>
					<div>
						<dt>2017–</dt>
						<dd>兵庫県立大学</dd>
					</div>
				</dl>
			</div>
		</section>

		<section class="research-profiles" aria-labelledby="research-profiles-heading">
			<div>
				<p class="section-label">Research Profiles</p>
				<h2 id="research-profiles-heading">研究者情報</h2>
			</div>
			<ul>
				<li><a href="https://scholar.google.com/citations?user=Bt6EL7MAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar<span aria-hidden="true"> ↗</span></a></li>
				<li><a href="https://www.semanticscholar.org/author/H.-Ohshima/1698449" target="_blank" rel="noopener noreferrer">Semantic Scholar<span aria-hidden="true"> ↗</span></a></li>
				<li><a href="https://dblp.org/pid/88/85.html" target="_blank" rel="noopener noreferrer">DBLP<span aria-hidden="true"> ↗</span></a></li>
				<li><a href="https://orcid.org/0000-0002-9492-2246" target="_blank" rel="noopener noreferrer">ORCID<span aria-hidden="true"> ↗</span></a></li>
				<li><a href="https://researchmap.jp/hohshima/" target="_blank" rel="noopener noreferrer">researchmap<span aria-hidden="true"> ↗</span></a></li>
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.profile-hero { padding-block: clamp(3rem, 7vw, 6rem); background: linear-gradient(135deg, #eef3ff 0%, #f8faff 58%, #fff 100%); }
	.profile-hero__inner { display: grid; grid-template-columns: 270px minmax(0, 1fr); align-items: center; gap: clamp(2rem, 6vw, 5rem); max-width: 950px; }
	.profile-hero img { width: 100%; height: auto; border-radius: 50%; box-shadow: 0 1.2rem 3rem rgba(35, 58, 105, 0.18); }
	.eyebrow, .section-label { margin: 0 0 0.65rem; color: var(--color-primary); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
	.profile-hero h1 { margin: 0; color: var(--color-heading); font-size: clamp(2.4rem, 6vw, 4.25rem); font-weight: 500; letter-spacing: 0.04em; line-height: 1.2; }
	.name-en { margin: 0.25rem 0 1.5rem; color: var(--color-muted); font-size: 1.1rem; letter-spacing: 0.06em; }
	.position { margin: 0 0 0.2rem; color: var(--color-heading); font-size: 1.15rem; font-weight: 600; }
	.affiliation { margin: 0; }
	.contact { margin: 1.15rem 0 0; }
	.profile-page { max-width: 1000px; padding-block: clamp(4rem, 8vw, 7rem); }
	.profile-page section + section { margin-top: clamp(4rem, 9vw, 7rem); }
	.profile-page h2 { margin: 0 0 1.5rem; color: var(--color-heading); font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 500; line-height: 1.4; }
	.introduction { max-width: 800px; }
	.introduction > p:last-child { margin: 0; font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 2; }
	.research-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.research-grid article { padding: 1.6rem; background: var(--color-soft); border-top: 3px solid var(--color-primary); }
	.research-grid h3 { margin: 0 0 0.75rem; color: var(--color-heading); font-size: 1.15rem; }
	.research-grid p { margin: 0; }
	.field-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
	.field-tags li { padding: 0.35rem 0.8rem; color: var(--color-nav); background: #fff; border: 1px solid var(--color-border); border-radius: 999px; font-size: 0.85rem; }
	.background { display: grid; grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.6fr); gap: clamp(2rem, 6vw, 5rem); padding-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--color-border); }
	.background__body > p { margin-top: 0; }
	.background dl { margin: 2rem 0 0; }
	.background dl div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding-block: 0.9rem; border-top: 1px solid var(--color-border); }
	.background dt { color: var(--color-primary); font-weight: 700; }
	.background dd { margin: 0; }
	.research-profiles { display: grid; grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.6fr); gap: clamp(2rem, 6vw, 5rem); padding-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--color-border); }
	.research-profiles ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
	.research-profiles a { display: block; padding: 0.9rem 1rem; color: var(--color-heading); background: var(--color-soft); border: 1px solid transparent; font-weight: 600; text-decoration: none; }
	.research-profiles a:hover { color: var(--color-primary); border-color: var(--color-primary); }
	@media (max-width: 46rem) {
		.profile-hero__inner { grid-template-columns: 1fr; text-align: center; }
		.profile-hero img { width: min(65vw, 250px); margin-inline: auto; }
		.research-grid, .background, .research-profiles { grid-template-columns: 1fr; }
		.background { gap: 0; }
		.research-profiles ul { grid-template-columns: 1fr; }
	}
	@media (max-width: 28rem) {
		.background dl div { grid-template-columns: 1fr; gap: 0.15rem; }
	}
</style>
