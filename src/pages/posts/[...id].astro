---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/paths';
import { getVisiblePosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} | 大島裕明研究室`} description={post.data.description}>
	<article class="post">
		<header class="post__header">
			<div class="container post__header-inner">
				<a class="post__back" href={sitePath('posts/')}>← 記事一覧</a>
				{post.data.draft && <p class="draft-notice">開発環境だけに表示される下書きです</p>}
				<h1>{post.data.title}</h1>
				<p>{post.data.description}</p>
				<time datetime={post.data.publishedDate.toISOString()}>{dateFormatter.format(post.data.publishedDate)}</time>
			</div>
		</header>
		<div class="container post__body">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.post__header { padding-block: clamp(3.5rem, 8vw, 6rem); background: var(--color-soft); }
	.post__header-inner, .post__body { max-width: 780px; }
	.post__back { display: inline-block; margin-bottom: 2rem; font-size: 0.9rem; text-decoration: none; }
	.post__header .draft-notice { width: fit-content; margin: 0 0 1rem; padding: 0.35rem 0.7rem; color: #8a4b08; background: #fff0d5; border: 1px solid #e7c68f; border-radius: 0.2rem; font-size: 0.82rem; font-weight: 600; }
	.post__header h1 { margin: 0; color: var(--color-heading); font-size: clamp(2rem, 5vw, 3rem); font-weight: 500; line-height: 1.4; }
	.post__header p { margin: 1rem 0; font-size: 1.08rem; }
	.post__header time { color: var(--color-muted); font-size: 0.9rem; }
	.post__body { padding-block: clamp(3.5rem, 8vw, 6rem); }
	.post__body :global(h2) { margin: 2.8rem 0 1rem; color: var(--color-heading); font-size: 1.65rem; font-weight: 500; }
	.post__body :global(h3) { margin: 2.2rem 0 0.8rem; color: var(--color-heading); font-size: 1.3rem; font-weight: 500; }
	.post__body :global(p), .post__body :global(ul), .post__body :global(ol) { margin-block: 1rem; }
	.post__body :global(img) { max-width: 100%; height: auto; }
	.post__body :global(blockquote) { margin: 1.5rem 0; padding: 0.2rem 1.25rem; color: var(--color-muted); border-left: 4px solid var(--color-primary); }
	.post__body :global(code) { padding: 0.12em 0.35em; background: var(--color-soft); border-radius: 0.2rem; }
</style>
