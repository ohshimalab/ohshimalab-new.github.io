---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { researchProfiles } from '../../data/research-profiles';
import { publicationGroups, publicationDate, publicationDetails, publicationLinks } from '../../data/publications';
const total = publicationGroups.reduce((sum, group) => sum + group.papers.length, 0);
const years = publicationGroups.flatMap(group => group.years.map(entry => entry.year));
---
<BaseLayout title="研究成果 | 大島裕明研究室" description="大島裕明研究室の論文誌・国際会議・国内会議の研究成果。発表年ごとの一覧と論文へのリンクを掲載しています。">
  <PageHeader label="Publications" title="研究成果" description="論文誌・国際会議・国内会議で発表した研究成果を紹介します。" id="publications-top">
    <p class="summary">{Math.min(...years)}–{Math.max(...years)} <span>／</span> 全{total}件</p>
    <nav class="research-profile-links" aria-label="大島裕明の研究者情報">
      <span>大島裕明の研究者情報</span>
      <ul>{researchProfiles.map(profile => <li><a href={profile.url} target="_blank" rel="noopener noreferrer">{profile.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
    </nav>
  </PageHeader>
  <div class="container publications-layout">
    <aside><nav class="contents" aria-label="研究成果の分類">
      <p class="contents-label">研究成果一覧</p>
      <ul>{publicationGroups.map(group => <li><a href={`#${group.id}`}><span>{group.title}</span><span class="count">{group.papers.length}</span></a></li>)}</ul>
      <p class="contents-note">各区分で新しいものから掲載</p>
    </nav></aside>
    <div class="publication-sections">
      {publicationGroups.map(group => (
        <section id={group.id} class="publication-group" aria-labelledby={`${group.id}-title`}>
          <header class="group-header"><p class="eyebrow">{group.english}</p><h2 id={`${group.id}-title`}>{group.title}<span>{group.papers.length}件</span></h2></header>
          <nav class="year-nav" aria-label={`${group.title}の発表年`}>{group.years.map(({ year }) => <a href={`#${group.id}-${year}`}>{year}</a>)}</nav>
          {group.years.map(({ year, start, papers }) => (
            <section class="year-group" aria-labelledby={`${group.id}-${year}`}>
              <h3 id={`${group.id}-${year}`}>{year}<span>{papers.length}件</span></h3>
              <ol start={start}>{papers.map(paper => (
                <li id={`publication-${paper.id}`}>
                  <p class="paper-title">{paper.title}</p>
                  <p class="authors">{paper.authors}</p>
                  <p class="citation">{publicationDetails(paper)}</p>
                  <div class="paper-meta">
                    <span>{publicationDate(paper)}</span>
                    {paper.reviewed !== null && <span class="review">{paper.reviewed ? '査読あり' : '査読なし'}</span>}
                    {paper.invited && <span class="review">招待</span>}
                    {publicationLinks(paper).map(link => <a href={link.url} target={link.label === 'DOI' ? '_blank' : undefined} rel={link.label === 'DOI' ? 'noopener noreferrer' : undefined} aria-label={`${paper.title}：${link.label}${link.label === 'DOI' ? '（新しいタブで開く）' : ''}`}>{link.label}<span aria-hidden="true"> ↗</span></a>)}
                  </div>
                  {paper.award && <p class="award">{paper.award}</p>}
                </li>
              ))}</ol>
            </section>
          ))}
          <a class="back-top" href="#publications-top">ページ上部へ ↑</a>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
<style>
  .research-profile-links { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1rem; margin-top: 1rem; font-size: .8rem; }
  .research-profile-links > span { color: var(--color-muted); }
  .research-profile-links ul { display: flex; flex-wrap: wrap; gap: .4rem 1rem; list-style: none; margin: 0; padding: 0; }
  .research-profile-links a { text-decoration: none; }
  .research-profile-links a:hover { text-decoration: underline; }
  .eyebrow { margin: 0 0 .5rem; color: var(--color-primary-dark); font-size: .78rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .summary { margin: 1.5rem 0 0; font-size: .88rem; font-variant-numeric: tabular-nums; }
  .summary span { margin-inline: .7rem; }
  .publications-layout { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); padding-block: 3rem 5rem; }
  .contents { position: sticky; top: 6rem; }
  .contents-label { margin: 0 0 .8rem; font-size: .8rem; font-weight: 600; }
  .contents ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-border); }
  .contents a { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem .2rem; border-bottom: 1px solid var(--color-border); text-decoration: none; color: var(--color-heading); }
  .contents a:hover { color: var(--color-primary); }
  .count { font-size: .85rem; color: var(--color-primary-dark); font-variant-numeric: tabular-nums; }
  .contents-note { font-size: .75rem; margin-top: 1rem; }
  .publication-group { scroll-margin-top: 6rem; }
  .publication-group + .publication-group { margin-top: 5rem; }
  .group-header { padding-bottom: 1rem; border-bottom: 2px solid var(--color-heading); }
  h2 { margin: 0; color: var(--color-heading); font-size: 1.75rem; font-weight: 600; }
  h2 span, h3 span { margin-left: 1rem; font-size: .8rem; font-weight: 400; color: var(--color-body); }
  .year-nav { display: flex; flex-wrap: wrap; gap: .35rem 1rem; padding-block: 1rem; }
  .year-nav a { font-size: .85rem; padding-block: .2rem; text-decoration: none; }
  .year-nav a:hover { text-decoration: underline; }
  h3 { display: flex; align-items: baseline; scroll-margin-top: 6rem; margin: 1.5rem 0 .25rem; font-size: 1.35rem; color: var(--color-heading); font-variant-numeric: tabular-nums; }
  ol { margin: 0; padding-left: 2.7rem; }
  li { overflow-wrap: anywhere; }
  ol li { padding: 1.25rem 0 1.35rem .4rem; border-bottom: 1px solid var(--color-border); }
  ol li::marker { color: var(--color-muted); font-size: .85rem; font-variant-numeric: tabular-nums; }
  .paper-title { margin: 0 0 .4rem; color: var(--color-heading); font-size: 1.02rem; font-weight: 600; line-height: 1.65; }
  .authors, .citation { margin: .2rem 0; font-size: .88rem; line-height: 1.7; }
  .paper-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .9rem; margin-top: .55rem; font-size: .78rem; }
  .review { background: var(--color-soft); padding: .05rem .45rem; border: 1px solid var(--color-border); border-radius: 3px; }
  .award { margin: .6rem 0 0; color: #775414; font-size: .85rem; font-weight: 600; }
  .back-top { display: block; width: fit-content; margin: 1.5rem 0 0 auto; font-size: .8rem; }
  @media (max-width: 48rem) {
    .publications-layout { grid-template-columns: minmax(0, 1fr); gap: 2rem; padding-top: 1.5rem; }
    .contents { position: static; }
    .contents ul { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; border: 0; }
    .contents a { gap: 1rem; padding: .6rem 0; }
    .contents-note { margin-bottom: 0; }
    ol { padding-left: 2rem; }
    ol li { padding-left: .15rem; }
    .paper-title { font-size: 1rem; }
  }
  @media print {
    .publications-layout { display: block; }
    aside, .year-nav, .back-top { display: none; }
    ol li { break-inside: avoid; }
  }
</style>
