---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts } from '../../utils/posts';

const posts = await getVisiblePosts();
---

<BaseLayout title="記事 | 大島裕明研究室" description="大島裕明研究室からの記事・お知らせの一覧です。">
	<header class="page-header">
		<div class="container">
			<p>Posts</p>
			<h1>記事</h1>
		</div>
	</header>
	<section class="home-section">
		<div class="container post-index">
			<PostList {posts} />
		</div>
	</section>
</BaseLayout>

<style>
	.page-header { padding-block: clamp(3.5rem, 7vw, 5.5rem); background: var(--color-soft); text-align: center; }
	.page-header p { margin: 0 0 0.3rem; color: var(--color-primary); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
	.page-header h1 { margin: 0; color: var(--color-heading); font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; }
	.post-index { max-width: 900px; }
</style>
