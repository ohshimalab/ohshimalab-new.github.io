function splitName(fullName: string) {
	const match = fullName.match(/^(.+?)\s*（(.+?)）$/);
	if (match) {
		return { ja: match[1], en: match[2] };
	}
	return { ja: fullName, en: '' };
}
---

<BaseLayout title="研究室メンバー | 大島裕明研究室" description="大島裕明研究室の教員、学生、卒業生・修了生、進路などのメンバー情報です。">
	<header class="page-header">
		<div class="container">
			<p>Members</p>
			<h1>研究室メンバー</h1>
		</div>
	</header>

	<div class="container members-container">
		<!-- 目次ナビゲーション -->
		<nav class="page-nav" aria-label="ページ内目次">
			<ul class="page-nav__list">
				<li><a href="#faculty">教員</a></li>
				<li><a href="#students">学生</a></li>
				<li><a href="#working-students">社会人学生</a></li>
				<li><a href="#research-students">研究生</a></li>
				<li><a href="#alumni">卒業生・修了生</a></li>
				<li><a href="#former-research-students">元研究生</a></li>
				<li><a href="#careers">就職先</a></li>
				<li><a href="#universities">修士入学者の出身大学（国内）</a></li>
			</ul>
		</nav>

		<div class="members-content">
			<!-- 教員 -->
			<section class="member-section" id="faculty">
				<div class="section-header">
					<h2>教員</h2>
					<span class="section-badge">{faculty.length} 名</span>
				</div>
				<div class="table-wrapper">
					<table class="member-table">
						<thead>
							<tr>
								<th style="width: 25%;">役職</th>
								<th>氏名</th>
							</tr>
						</thead>
						<tbody>
							{faculty.map((f) => {
								const parsed = splitName(f.name);
								return (
									<tr>
										<td>{f.title}</td>
										<td>
											<span class="name-ja">{parsed.ja}</span>
											{parsed.en && <span class="name-en">({parsed.en})</span>}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>

			<!-- 学生 -->
			<section class="member-section" id="students">
				<div class="section-header">
					<h2>学生</h2>
					<span class="section-badge">{students.length} 名</span>
				</div>
				<div class="table-wrapper">
					<table class="member-table">
						<thead>
							<tr>
								<th style="width: 25%;">学年</th>
								<th>氏名</th>
							</tr>
						</thead>
						<tbody>
							{students.map((s) => {
								const parsed = splitName(s.name);
								return (
									<tr>
										<td>{s.grade}</td>
										<td>
											<span class="name-ja">{parsed.ja}</span>
											{parsed.en && <span class="name-en">({parsed.en})</span>}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>

			<!-- 社会人学生 -->
			<section class="member-section" id="working-students">
				<div class="section-header">
					<h2>社会人学生</h2>
					<span class="section-badge">{workingStudents.length} 名</span>
				</div>
				<div class="table-wrapper">
					<table class="member-table">
						<thead>
							<tr>
								<th style="width: 25%;">学年</th>
								<th>氏名</th>
							</tr>
						</thead>
						<tbody>
							{workingStudents.map((s) => {
								const parsed = splitName(s.name);
								return (
									<tr>
										<td>{s.grade}</td>
										<td>
											<span class="name-ja">{parsed.ja}</span>
											{parsed.en && <span class="name-en">({parsed.en})</span>}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>

			<!-- 研究生 -->
			<section class="member-section" id="research-students">
				<div class="section-header">
					<h2>研究生</h2>
					<span class="section-badge">{researchStudents.length} 名</span>
				</div>
				<div class="table-wrapper">
					<table class="member-table">
						<thead>
							<tr>
								<th>氏名</th>
							</tr>
						</thead>
						<tbody>
							{researchStudents.map((name) => {
								const parsed = splitName(name);
								return (
									<tr>
										<td>
											<span class="name-ja">{parsed.ja}</span>
											{parsed.en && <span class="name-en">({parsed.en})</span>}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>

			<!-- 卒業生・修了生 -->
			<section class="member-section" id="alumni">
				<div class="section-header">
					<h2>卒業生・修了生</h2>
					<span class="section-badge">{alumni.length} 名</span>
				</div>
				<div class="table-wrapper">
					<table class="member-table alumni-table">
						<thead>
							<tr>
								<th style="width: 24%; text-align: center;">卒業・修了年月</th>
								<th style="width: 18%; text-align: center;">学位</th>
								<th>氏名</th>
							</tr>
						</thead>
						<tbody>
							{alumni.map((a) => {
								const parsed = splitName(a.name);
								return (
									<tr>
										<td style="text-align: center;" class="cell-muted">{a.year}</td>
										<td style="text-align: center;">{a.degree}</td>
										<td>
											<span class="name-ja">{parsed.ja}</span>
											{parsed.en && <span class="name-en">({parsed.en})</span>}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>

			<!-- 元研究生 -->
			<section class="member-section" id="former-research-students">
				<div class="section-header">
					<h2>元研究生</h2>
					<span class="section-badge">{formerResearchStudents.length} 名</span>
				</div>
				<div class="table-wrapper">
					<table class="member-table">
						<thead>
							<tr>
								<th>氏名</th>
							</tr>
						</thead>
						<tbody>
							{formerResearchStudents.map((name) => {
								const parsed = splitName(name);
								return (
									<tr>
										<td>
											<span class="name-ja">{parsed.ja}</span>
											{parsed.en && <span class="name-en">({parsed.en})</span>}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>

			<!-- 就職先 -->
			<section class="member-section" id="careers">
				<div class="section-header">
					<h2>就職先</h2>
				</div>
				<div class="chips-container">
					{careerDestinations.map((item) => (
						<div class="chip">
							<span class="chip-dot"></span>
							<span>{item}</span>
						</div>
					))}
				</div>
			</section>

			<!-- 出身大学 -->
			<section class="member-section" id="universities">
				<div class="section-header">
					<h2>修士入学者の出身大学（国内）</h2>
				</div>
				<div class="chips-container">
					{domesticUniversities.map((item) => (
						<div class="chip">
							<span class="chip-dot"></span>
							<span>{item}</span>
						</div>
					))}
				</div>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	/* ページヘッダー（postsページ等と統一） */
	.page-header {
		padding-block: clamp(3.5rem, 7vw, 5.5rem);
		background: var(--color-soft);
		text-align: center;
	}

	.page-header p {
		margin: 0 0 0.3rem;
		color: var(--color-primary);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.page-header h1 {
		margin: 0;
		color: var(--color-heading);
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 400;
	}

	/* コンテナレイアウト */
	.members-container {
		max-width: 900px;
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	/* 目次ナビゲーション（左アクセントバーのリストスタイル） */
	.page-nav {
		margin-bottom: 3.5rem;
		padding: 1.25rem 1.5rem;
		background: var(--color-soft);
		border-left: 4px solid var(--color-primary);
		border-radius: 4px;
	}

	.page-nav__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.page-nav__list a {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-primary);
		text-decoration: none;
	}

	.page-nav__list a:hover {
		color: var(--color-primary-dark);
		text-decoration: underline;
	}

	/* コンテンツセクション */
	.members-content {
		display: flex;
		flex-direction: column;
		gap: 3.75rem;
	}

	.member-section {
		scroll-margin-top: 5.5rem;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--color-border);
	}

	.section-header h2 {
		margin: 0;
		color: var(--color-heading);
		font-size: 1.4rem;
		font-weight: 600;
	}

	.section-badge {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-muted);
		background: var(--color-soft);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
	}

	/* レスポンシブ対応テーブル（横スクロール） */
	.table-wrapper {
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		background: #ffffff;
		border: 1px solid var(--color-border);
		border-radius: 6px;
	}

