---
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';
import { getVisiblePosts } from '../utils/posts';

const latestPosts = (await getVisiblePosts()).slice(0, 5);
const heroImage = `url('${sitePath('media/question-mark.jpg')}')`;
---

<BaseLayout>
	<section class="hero" aria-labelledby="site-heading" style={`--hero-image: ${heroImage}`}>
		<div class="hero__shade"></div>
		<div class="container hero__content">
			<p>兵庫県立大学 <a href="https://www.u-hyogo.ac.jp/gsis/">情報科学研究科</a></p>
			<h1 id="site-heading">大島裕明研究室</h1>
		</div>
	</section>

	<section class="home-section" id="about">
		<div class="container about">
			<h2 class="section-title">大島裕明研究室へようこそ</h2>
			<p>
				大島研究室では、社会において人が情報を取得して意思決定を行い、豊かに生活することを支える技術を研究しています。
				<strong>情報検索</strong>、<strong>データマイニング</strong>、<strong>情報デザイン</strong>といった研究分野を基軸としつつ、
				<strong>データベース</strong>、<strong>機械学習</strong>、<strong>自然言語処理</strong>といった情報学の様々な分野の知見を活用し、
				さらには、<strong>心理学</strong>、<strong>社会学</strong>、<strong>経営学</strong>なども視野に入れて研究を行っています。
			</p>
		</div>
	</section>

	<section class="home-section home-section--soft links-section" aria-label="主要なご案内">
		<div class="container feature-links">
			<article id="admission">
				<div class="feature-links__icon" aria-hidden="true">♟</div>
				<h2>学生募集</h2>
				<p>大島研究室で研究に取り組みたい方へ、研究内容や研究生活をご案内します。</p>
				<span class="coming-soon">ページ準備中</span>
			</article>
			<article id="projects">
				<div class="feature-links__icon" aria-hidden="true">⌕</div>
				<h2>研究プロジェクト</h2>
				<p>情報検索、生成AI、自然言語処理など、研究室で取り組むプロジェクトを紹介します。</p>
				<span class="coming-soon">ページ準備中</span>
			</article>
		</div>
	</section>

	<section class="home-section" id="posts">
		<div class="container posts">
			<h2 class="section-title">記事</h2>
			<PostList posts={latestPosts} />
			{latestPosts.length > 0 && <p class="posts__more"><a href={sitePath('posts/')}>すべての記事を見る</a></p>}
		</div>
	</section>

	<section class="home-section home-section--soft" id="access">
		<div class="container access">
			<h2 class="section-title">アクセス</h2>
			<div class="access__details">
				<div class="access__mark" aria-hidden="true">⌖</div>
				<address>
					<p><a href="mailto:ohshima@ai.u-hyogo.ac.jp">ohshima@ai.u-hyogo.ac.jp</a></p>
					<p><a href="tel:0787945349">078-794-5349</a></p>
					<p>〒651-2197 兵庫県神戸市西区学園西町8-2-1<br />兵庫県立大学 神戸商科キャンパス 情報科学研究棟</p>
				</address>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero { position: relative; display: grid; min-height: clamp(25rem, 50vw, 43rem); place-items: center; color: #fff; background-color: #171717; background-image: var(--hero-image); background-position: center; background-size: cover; background-repeat: no-repeat; }
	.hero__shade { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.18); }
	.hero__content { position: relative; text-align: center; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.65); }
	.hero__content p { margin: 0 0 1rem; font-size: clamp(1.2rem, 3vw, 2rem); font-weight: 300; }
	.hero__content a { color: #fff; }
	.hero h1 { margin: 0; font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 600; letter-spacing: 0.02em; line-height: 1.25; }
	.about { max-width: 950px; }
	.about p { margin: 0; font-size: clamp(1rem, 2vw, 1.15rem); text-align: justify; }
	.about strong { color: var(--color-primary); font-weight: 500; }
	.feature-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(2rem, 7vw, 7rem); max-width: 920px; text-align: center; }
	.feature-links article { scroll-margin-top: 7rem; }
	.feature-links__icon { width: 5.5rem; height: 5.5rem; margin: 0 auto 1.25rem; color: var(--color-primary); font-size: 3.6rem; line-height: 5.5rem; }
	.feature-links h2 { margin: 0 0 1rem; color: var(--color-primary); font-size: 1.6rem; font-weight: 500; }
	.feature-links p { margin: 0 auto 1rem; }
	.coming-soon { color: var(--color-muted); font-size: 0.88rem; }
	.posts { max-width: 900px; }
	.posts__more { margin: 2rem 0 0; text-align: center; }
	.access { max-width: 900px; }
	.access__details { display: grid; grid-template-columns: 7rem 1fr; align-items: start; gap: 2rem; }
	.access__mark { color: var(--color-primary); font-size: 4.5rem; line-height: 1; text-align: center; }
	.access address { font-style: normal; }
	.access address p { margin: 0 0 0.75rem; }
	@media (max-width: 42rem) {
		.hero { min-height: 28rem; }
		.about p { text-align: left; }
		.feature-links { grid-template-columns: 1fr; }
		.access__details { grid-template-columns: 1fr; text-align: center; }
	}
</style>
